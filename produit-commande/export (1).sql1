--  DDL for Trigger TRG_CLIENT_ID
--------------------------------------------------------

  CREATE OR REPLACE TRIGGER "MOEMEN"."TRG_CLIENT_ID" 
BEFORE INSERT ON CLIENT
FOR EACH ROW
BEGIN
  :NEW.ID_CLIENT := seq_client_id.NEXTVAL;
END;

/
